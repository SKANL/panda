{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    // `@panda/*` resolves to `src` inside this repository and to `dist` for
    // everyone else, through one custom export condition. Only this repo sets it
    // (here, in `tsconfig.build.base.json`, and in `vitest.shared.ts`), which is
    // what keeps the manifests correct for ANY packer while the development loop
    // keeps compiling source with no build present.
    "customConditions": ["panda-source"],
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["node"]
  }
}
