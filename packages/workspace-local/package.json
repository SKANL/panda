{
  "name": "@panda/workspace-local",
  "version": "0.1.0",
  "description": "The local-directory WorkspaceProvider: a workspace is a subdirectory of rootDir.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/panda.git",
    "directory": "packages/workspace-local"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "panda-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@panda/contracts": "workspace:*",
    "@panda/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
