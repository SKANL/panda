{
  "name": "@panda/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "panda-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validation": {
      "panda-source": "./src/validation.ts",
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@panda/kernel": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "METHOD-PLUGIN.md"
  ]
}
