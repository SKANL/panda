{
  "name": "@skanl/panda-cli",
  "version": "0.1.0",
  "description": "The `panda` command-line surface: argv, JSON output and exit codes, and nothing more.",
  "keywords": [
    "ai-agent",
    "panda",
    "cli",
    "mcp",
    "skills",
    "developer-tools"
  ],
  "homepage": "https://github.com/SKANL/panda#readme",
  "bugs": {
    "url": "https://github.com/SKANL/panda/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/panda.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "panda": "./dist/bin/panda.js"
  },
  "exports": {
    ".": {
      "panda-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@skanl/panda-environment": "workspace:*",
    "@skanl/panda-session": "workspace:*"
  },
  "devDependencies": {
    "@skanl/panda-contracts": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
