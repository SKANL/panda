{
  "name": "@panda/projection",
  "version": "0.1.0",
  "description": "Projects Registry entries into executors' native configuration, and owns the ledger that can take them back.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/panda.git",
    "directory": "packages/projection"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "panda-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@panda/contracts": "workspace:*",
    "@panda/lock": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@panda/registry": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
