{
  "name": "@panda/lock",
  "version": "0.0.0",
  "description": "The portable lockfile protocol: machine-scoped write serialization for any package, with neutral codes and no sibling dependency.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SKANL/panda.git",
    "directory": "packages/lock"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "panda-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@panda/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
